{
  "$comment": "状态机/门禁路由回归基准。每条用例 = 一份证据现场 fixtures + 一个门禁脚本调用 + 期望的退出码与输出关键词，对应 SKILL.md 的一条硬规则（skillAnchors 必须能在 SKILL.md 中找到，改文档不改基准会让 CI 失败，反之亦然）。新增用例先跑 runner 确认断言真实生效。",
  "cases": [
    {
      "id": "RB-001",
      "title": "GATE-2 硬阻断：URL 不是证据，空目录必须停在 EVIDENCE_GATE",
      "skillAnchors": ["URL 不是证据"],
      "script": "check_evidence.js",
      "args": ["--case-dir", "{caseDir}", "--url", "https://api.example.com/v1/data", "--markdown"],
      "files": {},
      "expectExit": 1,
      "stdoutIncludes": ["缺失证据"]
    },
    {
      "id": "RB-002",
      "title": "单独 JS 文件只是辅助材料，不计为 Step 1",
      "skillAnchors": ["单独 JS、截图或指纹基线只作辅助材料"],
      "script": "check_evidence.js",
      "args": ["--case-dir", "{caseDir}", "--url", "https://api.example.com/v1/data", "--markdown"],
      "files": {
        "case/forensic/app.js": "var a = 1; function sign(x) { return x; }"
      },
      "expectExit": 1,
      "stdoutIncludes": ["Step 1 网络取证证据"]
    },
    {
      "id": "RB-003",
      "title": "capture 命中 --require-network-signal 的非 OPTIONS 2xx 时 Step 1 具备（缺 Step 2 仍阻断）",
      "skillAnchors": ["--require-network-signal"],
      "script": "check_evidence.js",
      "args": ["--case-dir", "{caseDir}", "--url", "https://api.example.com/v1/data", "--require-network-signal", "api.example.com/v1/data", "--markdown"],
      "files": {
        "case/forensic/capture.json": "[{\"url\": \"https://api.example.com/v1/data\", \"method\": \"POST\", \"request_body\": \"x=1\", \"response_status\": 200, \"response_headers\": {\"content-type\": \"application/json\"}}]"
      },
      "expectExit": 1,
      "stdoutIncludes": ["Step 2"],
      "stdoutExcludes": ["Step 1 网络取证证据（无有效"]
    },
    {
      "id": "RB-004",
      "title": "目标接口只有 OPTIONS 响应不算 Step 1 命中（PARTIAL 语义）",
      "skillAnchors": ["OPTIONS"],
      "script": "check_evidence.js",
      "args": ["--case-dir", "{caseDir}", "--url", "https://api.example.com/v1/data", "--require-network-signal", "api.example.com/v1/data", "--markdown"],
      "files": {
        "case/forensic/capture.json": "[{\"url\": \"https://api.example.com/v1/data\", \"method\": \"OPTIONS\", \"response_status\": 204, \"response_headers\": {}}]"
      },
      "expectExit": 1,
      "stdoutIncludes": ["Step 1 网络取证证据"]
    },
    {
      "id": "RB-005",
      "title": "TRACE_CAPTURE 出口门禁：Step 1-only 不得进入 CASE_LOOKUP",
      "skillAnchors": ["TRACE_CAPTURE 出口门禁复检"],
      "script": "check_trace_gate.js",
      "args": ["--case-dir", "{caseDir}", "--url", "https://api.example.com/v1/data", "--markdown"],
      "files": {
        "case/forensic/capture.json": "[{\"url\": \"https://api.example.com/v1/data\", \"method\": \"POST\", \"request_body\": \"x=1\", \"response_status\": 200}]"
      },
      "expectExit": 1,
      "stdoutIncludes": ["停在 TRACE_CAPTURE"]
    },
    {
      "id": "RB-006",
      "title": "Step1+Step2 齐备且 writer 信号命中 → 出口门禁放行 CASE_LOOKUP",
      "skillAnchors": ["才可进入 CASE_LOOKUP"],
      "script": "check_trace_gate.js",
      "args": ["--case-dir", "{caseDir}", "--url", "https://api.example.com/v1/data", "--require-trace-signal", "Headers.set", "--markdown"],
      "files": {
        "case/forensic/capture.json": "[{\"url\": \"https://api.example.com/v1/data\", \"method\": \"POST\", \"request_body\": \"x=1\", \"response_status\": 200}]",
        "case/ruyi-trace/logs/trace.ndjson": "{\"api\": \"Headers.set\", \"t\": \"call\", \"args\": [\"x-sign\", \"abc\"], \"url\": \"https://api.example.com/v1/data\", \"stack\": [{\"file\": \"https://static.example.com/app.js\", \"line\": 10, \"col\": 5}]}\n"
      },
      "expectExit": 0,
      "stdoutIncludes": ["可进入 CASE_LOOKUP"]
    },
    {
      "id": "RB-007",
      "title": "NDJSON 已产出但 writer 信号未命中 → 覆盖不足停在 TRACE_RETRY，不得写成「没有 trace」",
      "skillAnchors": ["不得写成“没有 trace”"],
      "script": "check_trace_gate.js",
      "args": ["--case-dir", "{caseDir}", "--url", "https://api.example.com/v1/data", "--require-trace-signal", "handshake", "--markdown"],
      "files": {
        "case/forensic/capture.json": "[{\"url\": \"https://api.example.com/v1/data\", \"method\": \"POST\", \"request_body\": \"x=1\", \"response_status\": 200}]",
        "case/ruyi-trace/logs/trace.ndjson": "{\"api\": \"Headers.set\", \"t\": \"call\", \"args\": [\"x-sign\", \"abc\"], \"url\": \"https://api.example.com/v1/data\", \"stack\": [{\"file\": \"https://static.example.com/app.js\", \"line\": 10, \"col\": 5}]}\n"
      },
      "expectExit": 1,
      "stdoutIncludes": ["TRACE_RETRY"]
    },
    {
      "id": "RB-008",
      "title": "裸泛化 API（createElement）不得作为 writer 证据信号，门禁直接拒绝",
      "skillAnchors": ["裸 `createElement`"],
      "script": "check_trace_gate.js",
      "args": ["--case-dir", "{caseDir}", "--url", "https://api.example.com/v1/data", "--require-trace-signal", "createElement", "--markdown"],
      "files": {},
      "expectExit": 1,
      "outputIncludes": ["泛化"]
    },
    {
      "id": "RB-009",
      "title": "STEP2_ONLY：用户已提供 NDJSON 时出口门禁直接通过",
      "skillAnchors": ["STEP2_ONLY"],
      "script": "check_trace_gate.js",
